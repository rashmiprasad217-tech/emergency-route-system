# Flask Secret Key (for session encryption)
SECRET_KEY=YOUR_SUPER_SECRET_KEY_HERE

# MongoDB Connection URI
# Local MongoDB: mongodb://localhost:27017/emergency_route_system
# MongoDB Atlas Cloud: mongodb+srv://<username>:<password>@cluster.mongodb.net/emergency_route_system
MONGO_URI=mongodb://localhost:27017/emergency_route_system

# Google Maps API Key
# (Requires Maps JavaScript API, Places API, and Directions API enabled)
GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY_HERE
